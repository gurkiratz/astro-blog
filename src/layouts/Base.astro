---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../site.config';
import { themes, themeOpacityFraction } from '../theme.config';
import ExternalLinks from '../components/ExternalLinks.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeBackground from '../components/ThemeBackground.astro';
import ThemeBootstrap from '../components/ThemeBootstrap.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <ThemeBootstrap />
    <ClientRouter />
  </head>
  <body style={`--marker: '${site.marker}'`}>
    <ThemeBackground />

    <div
      class="pointer-events-none fixed inset-0 bg-base"
      style={`opacity: var(--scrim-opacity, ${themeOpacityFraction(themes[0])})`}
      transition:persist="site-background-scrim"
    >
    </div>
    <div
      class="relative z-10 mx-auto flex min-h-dvh max-w-[40rem] flex-col px-6 py-10 md:py-14"
    >
      <header class="relative">
        <ThemeSwitcher />
        <a
          href="/"
          class="text-ink font-medium no-underline hover:no-underline hover:text-ink"
        >
          <span class="text-accent">{site.prompt}</span>
          {site.name}
        </a>
        {
          site.tagline ? (
            <p class="mt-0.5 text-faint" style="font-size:0.9rem">
              {site.tagline}
            </p>
          ) : null
        }
        <nav class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
          {
            site.nav.map((item) => (
              <a
                href={item.href}
                class="text-muted no-underline hover:text-accent"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main class="mt-9 flex-1">
        <slot />
      </main>

      <SiteFooter />
    </div>
    <ExternalLinks />
    <script>
      import { bind } from 'cuelume';

      bind();
    </script>
  </body>
</html>
