---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../site.config';
import { themes, themeOpacityFraction } from '../theme.config';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeBackground from '../components/ThemeBackground.astro';
import ThemeBootstrap from '../components/ThemeBootstrap.astro';

interface Props {
  title?: string;
  description?: string;
  /**
   * Let <main> span the full viewport width instead of the 40rem measure.
   * The header (and footer, when shown) stay inside the measure, so the page
   * still reads as part of the site. Used by /canvas.
   */
  bleed?: boolean;
  /** Set false for pages that own the whole viewport, e.g. /canvas. */
  footer?: boolean;
}

const {
  title,
  description = site.description,
  bleed = false,
  footer = true,
} = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;

// In bleed mode the padding moves off the shell and onto the header/footer
// rails, so only those stay constrained while <main> runs edge to edge.
const shellClass = bleed
  ? 'relative z-10 flex min-h-dvh flex-col'
  : 'relative z-10 mx-auto flex min-h-dvh max-w-[40rem] flex-col px-6 py-10 md:py-14';
const railClass = bleed ? 'mx-auto w-full max-w-[40rem] px-6' : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <ThemeBootstrap />
    <ClientRouter />
  </head>
  <body style={`--marker: '${site.marker}'`}>
    <ThemeBackground />

    <div
      class="pointer-events-none fixed inset-0 bg-base transition-[opacity,background-color] duration-500 ease-out"
      style={`opacity: var(--scrim-opacity, ${themeOpacityFraction(themes[0])})`}
      transition:persist="site-background-scrim"
      data-theme-easing-exempt
    >
    </div>
    <div class={shellClass}>
      <div class:list={[railClass, bleed && 'pt-10 md:pt-14']}>
        <SiteHeader />
      </div>

      <main class="mt-9 flex-1">
        <slot />
      </main>

      {
        footer ? (
          <div class:list={[railClass, bleed && 'pb-10 md:pb-14']}>
            <SiteFooter />
          </div>
        ) : null
      }
    </div>
    <script>
      import { bind } from 'cuelume';

      bind();
    </script>
  </body>
</html>
