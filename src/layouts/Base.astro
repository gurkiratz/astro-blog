---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../site.config';
import { themes, themeOpacityFraction } from '../theme.config';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeBackground from '../components/ThemeBackground.astro';
import ThemeBootstrap from '../components/ThemeBootstrap.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <ThemeBootstrap />
    <ClientRouter />
  </head>
  <body style={`--marker: '${site.marker}'`}>
    <ThemeBackground />

    <div
      class="pointer-events-none fixed inset-0 bg-base transition-[opacity,background-color] duration-500 ease-out"
      style={`opacity: var(--scrim-opacity, ${themeOpacityFraction(themes[0])})`}
      transition:persist="site-background-scrim"
      data-theme-easing-exempt
    >
    </div>
    <div
      class="relative z-10 mx-auto flex min-h-dvh max-w-[40rem] flex-col px-6 py-10 md:py-14"
    >
      <SiteHeader />

      <main class="mt-9 flex-1">
        <slot />
      </main>

      <SiteFooter />
    </div>
    <script>
      import { bind } from 'cuelume';

      bind();
    </script>
  </body>
</html>
