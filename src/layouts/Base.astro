---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import '../styles/global.css';
import { site } from '../site.config';
import { themes, THEME_STORAGE_KEY, themeOpacityFraction, themePosition } from '../theme.config';
import ExternalLinkIcon from '../components/ExternalLinkIcon.astro';
import ThemeBackground from '../components/ThemeBackground.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';


interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.name;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const [posts, photos] = await Promise.all([
  getCollection('writing', ({ data }) => !data.draft),
  getCollection('photos', ({ data }) => !data.draft),
]);
const latestDate = [...posts, ...photos]
  .map((entry) => entry.data.date)
  .sort((a, b) => b.valueOf() - a.valueOf())[0];
const updatedLabel = latestDate
  ? latestDate.toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    {
      /* is:inline keeps this a synchronous classic script (Astro's normal
      script processing emits `type="module"`, which defers execution past
      first paint — too late to avoid a flash). That also rules out
      define:vars, which needs Astro's normal processing to inject values,
      so the theme colors/key are serialized into the script text directly
      via set:html instead. Applies the saved accent color and background
      image before first paint, so the header nav doesn't flash the default
      color and then jump to the stored one once ThemeBackground.astro's
      module script catches up. */
    }
    <script
      is:inline
      set:html={`try {
        var colors = ${JSON.stringify(themes.map((t) => t.color))};
        var opacities = ${JSON.stringify(themes.map((t) => themeOpacityFraction(t)))};
        var images = ${JSON.stringify(themes.map((t) => t.image))};
        var positions = ${JSON.stringify(themes.map((t) => themePosition(t)))};
        var i = parseInt(localStorage.getItem(${JSON.stringify(THEME_STORAGE_KEY)}) || '0', 10);
        var root = document.documentElement.style;
        var color = colors[i] || colors[0];
        var opacity = opacities[i] || opacities[0];
        var image = images[i] || images[0];
        var position = positions[i] || positions[0];
        if (color) root.setProperty('--color-accent', color);
        if (opacity) root.setProperty('--scrim-opacity', opacity);
        if (image) root.setProperty('--theme-image', "url('" + image + "')");
        if (position) root.setProperty('--theme-position', position);
      } catch (e) {}`}
    />
  </head>
  <body style={`--marker: '${site.marker}'`}>
    <ThemeBackground />

    <div
      class="pointer-events-none fixed inset-0 bg-base"
      style={`opacity: var(--scrim-opacity, ${themeOpacityFraction(themes[0])})`}
      transition:persist="site-background-scrim"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-[46rem] px-6 py-10 md:py-14">
      <header class="relative">
        <ThemeSwitcher />
        <a
          href="/"
          class="text-ink no-underline hover:no-underline"
          style="font-size:1.4rem"
        >
          <span class="text-accent">{site.prompt}</span>
          {site.name}
        </a>
        {
          updatedLabel ? (
            <p class="mt-2 text-faint" style="font-size:0.85rem">
              Updated {updatedLabel}
            </p>
          ) : site.tagline ? (
            <p class="mt-2 text-faint" style="font-size:0.85rem">
              {site.tagline}
            </p>
          ) : null
        }
        <nav
          class="mt-5 flex flex-wrap gap-x-5 gap-y-1"
          style="font-size:0.9rem"
        >
          {
            site.nav.map((item) => (
              <a
                href={item.href}
                class={
                  isActive(item.href)
                    ? 'text-ink border-b border-accent pb-0.5 hover:no-underline'
                    : 'text-accent underline-offset-4 hover:underline'
                }
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </header>

      <main class="mt-9">
        <slot />
      </main>

      <footer
        class="mt-16 border-t border-rule pt-6 text-faint"
        style="font-size:0.8rem"
      >
        <p
          class="mb-3"
          data-local-time
          data-timezone={site.timezone}
          data-location={site.location}
        >
          <span class="text-ink" data-local-time-value>—</span>
          <span> in {site.location}</span>
        </p>
        <div class="flex flex-wrap gap-x-4">
          {
            site.social.map((s) => (
              <a href={s.href} class="underline-offset-4 hover:underline">
                {s.label}
              </a>
            ))
          }
        </div>
      </footer>
    </div>
    <template id="external-link-icon-template">
      <ExternalLinkIcon />
    </template>
    <script is:inline>
      function enhanceExternalLinks(root) {
        var template = document.getElementById('external-link-icon-template');
        if (!template) return;

        (root || document).querySelectorAll('a[href^="http"]').forEach(function (a) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
          if (a.querySelector('.external-link-icon')) return;
          a.appendChild(template.content.cloneNode(true));
        });
      }

      function formatLocalTime(date, timeZone) {
        var parts = new Intl.DateTimeFormat('en-US', {
          timeZone: timeZone,
          hour: 'numeric',
          minute: '2-digit',
          hour12: true,
        }).formatToParts(date);
        var hour = '';
        var minute = '';
        var dayPeriod = '';
        for (var i = 0; i < parts.length; i++) {
          if (parts[i].type === 'hour') hour = parts[i].value;
          if (parts[i].type === 'minute') minute = parts[i].value;
          if (parts[i].type === 'dayPeriod') dayPeriod = parts[i].value.toLowerCase();
        }
        return hour + ':' + minute + dayPeriod;
      }

      var localTimeTimer = null;
      function startLocalTime() {
        var el = document.querySelector('[data-local-time]');
        if (!el) return;
        var value = el.querySelector('[data-local-time-value]');
        if (!value) return;
        var timeZone = el.getAttribute('data-timezone') || 'America/Toronto';
        function tick() {
          value.textContent = formatLocalTime(new Date(), timeZone);
        }
        tick();
        if (localTimeTimer) clearInterval(localTimeTimer);
        localTimeTimer = setInterval(tick, 30000);
      }

      enhanceExternalLinks();
      startLocalTime();
      document.addEventListener('astro:page-load', function () {
        enhanceExternalLinks(document);
        startLocalTime();
      });
    </script>
  </body>
</html>
