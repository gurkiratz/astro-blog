---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../site.config';
import { themes, themeOpacityFraction } from '../theme.config';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ThemeBackground from '../components/ThemeBackground.astro';
import ThemeBootstrap from '../components/ThemeBootstrap.astro';

interface Props {
  title?: string;
  description?: string;
  /**
   * Let <main> span the full viewport width instead of the 40rem measure.
   * The header (and footer, when shown) stay inside the measure, so the page
   * still reads as part of the site. Used by /canvas.
   */
  bleed?: boolean;
  /** Set false for pages that own the whole viewport, e.g. /canvas. */
  footer?: boolean;
  /**
   * Widen the measure from 40rem to 64rem for the whole page — header, main
   * and footer together, so nothing goes out of alignment. For pages whose
   * content is images rather than prose, e.g. /photos.
   */
  wide?: boolean;
  /** Keep this page out of search results, e.g. /404. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  bleed = false,
  footer = true,
  wide = false,
  noindex = false,
} = Astro.props;
const pageTitle = title
  ? `${title} — ${site.name}`
  : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isHome = Astro.url.pathname === '/';

// Tells search engines who this site is about, so a search for the name
// links the person, this site and the profiles below together.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
  jobTitle: site.role,
  worksFor: { '@type': 'Organization', name: 'The IJF', url: 'https://theijf.org' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Humber Polytechnic' },
  address: { '@type': 'PostalAddress', addressLocality: 'Toronto', addressCountry: 'CA' },
  sameAs: [site.github, site.linkedin, site.bluesky, ...site.previousSites],
};

// In bleed mode the padding moves off the shell and onto the header/footer
// rails, so only those stay constrained while <main> runs edge to edge.
// Written out in full rather than interpolated: Tailwind finds classes by
// scanning the source for literal strings.
const measure = wide ? 'max-w-[64rem]' : 'max-w-[40rem]';
const shellClass = bleed
  ? 'relative z-10 flex min-h-dvh flex-col'
  : `relative z-10 mx-auto flex min-h-dvh w-full ${measure} flex-col px-6 py-10 md:py-14`;
const railClass = bleed ? `mx-auto w-full ${measure} px-6` : null;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    {
      isHome && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(person)}
        />
      )
    }
    <meta name="generator" content={Astro.generator} />
    <ThemeBootstrap />
    <ClientRouter />
  </head>
  <body style={`--marker: '${site.marker}'`}>
    <ThemeBackground />

    <div
      class="pointer-events-none fixed inset-0 bg-base transition-[opacity,background-color] duration-500 ease-out"
      style={`opacity: var(--scrim-opacity, ${themeOpacityFraction(themes[0])})`}
      transition:persist="site-background-scrim"
      data-theme-easing-exempt
    >
    </div>
    <div class={shellClass}>
      <div class:list={[railClass, bleed && 'pt-10 md:pt-14']}>
        <SiteHeader />
      </div>

      <main class="mt-9 flex-1">
        <slot />
      </main>

      {
        footer ? (
          <div class:list={[railClass, bleed && 'pb-10 md:pb-14']}>
            <SiteFooter />
          </div>
        ) : null
      }
    </div>
    <script>
      import { bind } from 'cuelume';

      bind();
    </script>
  </body>
</html>
