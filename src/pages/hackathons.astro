---
import Base from '../layouts/Base.astro';
import { hackathons, labelTone as hackathonLabelTone } from '../data/hackathons';
import { hackathonProjects, labelTone } from '../data/projects';
---

<Base title="Hackathons">
  <h1 class="text-ink font-medium" style="font-size:1.1rem">
    <span class="text-faint" data-marker></span> Hackathons
  </h1>
  <p class="mt-2 text-muted" style="font-size:0.9rem">
    Competitions and weekend builds I've shown up for.
  </p>

  <ul class="mt-8 space-y-7">
    {
      hackathons.map((h) => (
        <li>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="text-ink">{h.event}</span>
            <span class="text-faint" style="font-size:0.8rem">
              {h.year}
            </span>
            {h.labels?.map((label) => (
              <span class={`pill pill-${hackathonLabelTone(label)}`}>{label}</span>
            ))}
          </div>
          <p class="mt-1 text-muted" style="font-size:0.9rem">
            <span class="text-ink">{h.name}</span>
            {' — '}
            {h.description}
          </p>
          {h.links && h.links.length > 0 && (
            <p class="mt-1" style="font-size:0.85rem">
              {h.links.map((l, i) => (
                <>
                  {i > 0 && <span class="text-faint"> · </span>}
                  <a href={l.href}>{l.label}</a>
                </>
              ))}
            </p>
          )}
        </li>
      ))
    }
    {
      hackathonProjects.map((p) => (
        <li>
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="text-ink">{p.name}</span>
            <span class="text-faint" style="font-size:0.8rem">
              {p.year}
            </span>
            {p.labels?.map((label) => (
              <span class={`pill pill-${labelTone(label)}`}>{label}</span>
            ))}
          </div>
          <p class="mt-1 text-muted" style="font-size:0.9rem">
            {p.description}
          </p>
          {p.links && p.links.length > 0 && (
            <p class="mt-1" style="font-size:0.85rem">
              {p.links.map((l, i) => (
                <>
                  {i > 0 && <span class="text-faint"> · </span>}
                  <a href={l.href}>{l.label}</a>
                </>
              ))}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</Base>
