---
import { links } from '@/site.config';
import Base from '../layouts/Base.astro';
---

<Base title="About">
  <h1 class="text-ink font-medium" style="font-size:1.1rem">
    <span class="text-faint" data-marker></span> About
  </h1>
  <div class="prose mt-6">
    <!-- TODO: replace with your real intro -->
    <p>
      Hi, I'm Gurkirat. I'm a software developer at <a href="https://theijf.org/staff/gurkirat-singh">The IJF</a>. I'm in my final year of CS degree at Humber Polytechnic.
    </p>
    <p>I like to take <a href="/photography">photos</a>, play <a href="writing/music">music</a> instruments and ride my <a href="/writing/biking">bike</a>.</p>
    <p>
      This <a href="/writing/how-i-made-this-site">site</a> is where I keep my thoughts, projects, and everything I do in my life.
    </p>
    <h2>Elsewhere</h2>
    <ul>
      <li>GitHub - <a href={links.github}>github.com/gurkiratz</a></li>
      <li>LinkedIn - <a href={links.linkedin}>linkedin.com/in/gurkiratz</a></li>
      <li>Bluesky - <a href={links.bluesky}>@gurkirat.bsky.social</a></li>
      <li>Email - <a href={links.email}>gurkirat.singh@humber.ca</a></li>
    </ul>
  </div>
</Base>
