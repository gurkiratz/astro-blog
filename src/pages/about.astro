---
import { Mail } from '@lucide/astro';
import Bluesky from 'simple-icons-astro/Bluesky';
import Github from 'simple-icons-astro/Github';
import X from 'simple-icons-astro/X';
import { links } from '@/site.config';
import Base from '../layouts/Base.astro';
---

<Base title="About">
  <h1 class="text-ink font-medium" style="font-size:1.1rem">
    <span class="text-faint" data-marker></span> About
  </h1>
  <div class="prose mt-6">
    <!-- TODO: replace with your real intro -->
    <p>
      Hi, I'm Gurkirat. I'm a software developer at <a href="https://theijf.org/staff/gurkirat-singh">The IJF</a>. I'm in my final year of CS degree at Humber Polytechnic.
    </p>
    <p>I like to take <a href="/photos">photos</a>, play <a href="writing/music">music</a> instruments and ride my <a href="/writing/biking">bike</a>.</p>
    <p>
      This <a href="/writing/how-i-made-this-site">site</a> is where I keep my thoughts, projects, and everything I do in my life.
    </p>
    <h2>Elsewhere</h2>
  </div>
  <ul class="elsewhere">
    <li>
      <a href={links.github}>
        <Github size={16} fill="currentColor" aria-hidden="true" />
        gurkiratz
      </a>
    </li>
    <li>
      <a href={links.linkedin}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path
            d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
          ></path>
        </svg>
        in/gurkiratz
      </a>
    </li>
    <li>
      <a href={links.bluesky}>
        <Bluesky size={16} fill="currentColor" aria-hidden="true" />
        @gurkiratz.co
      </a>
    </li>
    <li>
      <a href={links.x}>
        <X size={16} fill="currentColor" aria-hidden="true" />
        @theGurSingh
      </a>
    </li>
    
    <li>
      <a href={links.email}>
        <Mail size={16} aria-hidden="true" />
        gurkirat.singh@humber.ca
      </a>
    </li>
  </ul>
</Base>

<style>
  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
  }
  .elsewhere a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  .elsewhere a :global(svg) {
    flex-shrink: 0;
    color: var(--color-faint);
  }
  .elsewhere a:hover :global(svg) {
    color: currentColor;
  }
</style>
