---
import Base from '../layouts/Base.astro';
---

<Base title="404">
  <p class="text-faint" style="font-size:0.9rem">
    $ cat <span class="text-muted">./the-page-you-wanted</span>
  </p>
  <p class="mt-1 text-tag-pink" style="font-size:0.9rem">
    cat: no such file or directory
  </p>
  <h1 class="mt-6 text-ink" style="font-size:1.4rem">404 — page not found</h1>
  <p class="mt-2 text-muted">
    that page isn't here. it may have moved, or it never existed.
  </p>
  <p class="mt-4"><a href="/">← back home</a></p>
</Base>
