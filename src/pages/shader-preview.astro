---
// Scratch page for comparing @paper-design/shaders effects side by side.
// Not linked from nav — delete once you've picked a favorite.
import Base from '../layouts/Base.astro';
import HalftoneBackground from '../components/HalftoneBackground.astro';
import WaterBackground from '../components/WaterBackground.astro';
import PaperTextureBackground from '../components/PaperTextureBackground.astro';
import HalftoneCmykBackground from '../components/HalftoneCmykBackground.astro';

const boxClass = 'relative h-72 w-full overflow-hidden rounded border border-rule';
---

<Base title="shader preview">
  <h1 class="text-ink" style="font-size:1.4rem">
    <span class="text-faint" data-marker></span> shader preview
  </h1>
  <p class="mt-2 text-muted" style="font-size:0.9rem">
    side-by-side comparison, all driven by <code>/flower.png</code>.
  </p>

  <div class="mt-8 space-y-10">
    <section>
      <h2 class="mb-2 text-muted" style="font-size:0.9rem">halftone dots (current background)</h2>
      <div class={boxClass}>
        <HalftoneBackground class="absolute inset-0" />
      </div>
    </section>

    <section>
      <h2 class="mb-2 text-muted" style="font-size:0.9rem">water</h2>
      <div class={boxClass}>
        <WaterBackground class="absolute inset-0" />
      </div>
    </section>

    <section>
      <h2 class="mb-2 text-muted" style="font-size:0.9rem">paper texture</h2>
      <div class={boxClass}>
        <PaperTextureBackground class="absolute inset-0" />
      </div>
    </section>

    <section>
      <h2 class="mb-2 text-muted" style="font-size:0.9rem">halftone cmyk</h2>
      <div class={boxClass}>
        <HalftoneCmykBackground class="absolute inset-0" />
      </div>
    </section>
  </div>
</Base>
