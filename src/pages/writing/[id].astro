---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const longDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <a
      href="/writing"
      class="text-faint no-underline hover:text-ink"
      style="font-size:0.9rem">← Writing</a
    >
    <h1 class="mt-4 text-ink font-medium leading-tight" style="font-size:1.35rem">
      {post.data.title}
    </h1>
    <p class="mt-2 text-faint" style="font-size:0.9rem">
      {longDate(post.data.date)}
      {
        post.data.tags.length > 0 && (
          <span> · {post.data.tags.join(', ')}</span>
        )
      }
    </p>
    <div class="prose mt-8">
      <Content />
    </div>
  </article>
</Base>
