---
import Base from '../../layouts/Base.astro';
import WritingPostList from '../../components/WritingPostList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Writing">
  <h1 class="text-ink font-medium" style="font-size:1.1rem">
    <span class="text-faint" data-marker></span> Writing
  </h1>
  <p class="mt-2 text-muted" style="font-size:0.9rem">
    Things I've written down. <a href="/rss.xml">RSS →</a>
  </p>
  <WritingPostList posts={posts} groupByYear />
</Base>
