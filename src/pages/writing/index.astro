---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const shortDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

const byYear = new Map<number, CollectionEntry<'writing'>[]>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  const list = byYear.get(year);
  if (list) list.push(post);
  else byYear.set(year, [post]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<Base title="Writing">
  <h1 class="text-ink font-medium" style="font-size:1.1rem">
    <span class="text-faint" data-marker></span> Writing
  </h1>
  <p class="mt-2 text-muted" style="font-size:0.9rem">
    Things I've written down. <a href="/rss.xml">RSS →</a>
  </p>
  {
    years.map((year) => (
      <section class="mt-8">
        <h2 class="mb-2 text-faint" style="font-size:0.8rem">
          {year}
        </h2>
        <ul class="space-y-2">
          {byYear.get(year)!.map((post) => (
            <li class="flex flex-wrap items-baseline gap-x-3">
              <span
                class="w-12 shrink-0 text-faint tabular-nums"
                style="font-size:0.85rem"
              >
                {shortDate(post.data.date)}
              </span>
              <a href={`/writing/${post.id}/`} class="no-underline hover:underline">
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
