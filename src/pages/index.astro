---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const shortDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
---

<Base>
  <section>

    <ul class="space-y-1.5">
      <li>daily-driving arch + hyprland; dotfiles finally sane</li>
      <li>building this site by hand — <a href="/now">/now →</a></li>
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="mb-3 text-muted" style="font-size:0.9rem">
      <span class="text-faint" data-marker></span> Recent posts
    </h2>
    <ul class="space-y-2">
      {
        posts.map((post) => (
          <li class="flex flex-wrap items-baseline gap-x-3">
            <span
              class="w-12 shrink-0 text-faint tabular-nums"
              style="font-size:0.85rem"
            >
              {shortDate(post.data.date)}
            </span>
            <a href={`/writing/${post.id}/`} class="no-underline hover:underline">
              {post.data.title}
            </a>
            {post.data.tags[0] && (
              <span class="text-faint" style="font-size:0.85rem">
                {post.data.tags[0]}
              </span>
            )}
          </li>
        ))
      }
    </ul>
    <p class="mt-4"><a href="/writing" class="text-muted">All posts →</a></p>
  </section>
</Base>
