---
import Base from '../layouts/Base.astro';
import WritingPostList from '../components/WritingPostList.astro';
import { getCollection } from 'astro:content';
import { site } from '../site.config';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);
---

<Base>
  <section>

    <ul class="space-y-4">
      <li>I build software to solve my own problems, like this <a href="https://kirtansewa-player.vercel.app/">personal music player</a>.</li>
      <li>Say hi on <a href={site.github}>GitHub</a>, <a href={site.linkedin}>LinkedIn</a>, or <a href={site.email}>Email</a> if you want to talk.</li>
    </ul>
  </section>

  <section class="mt-10">
    <h2 class="mb-3 text-muted" style="font-size:0.9rem">
      <span class="text-faint" data-marker></span> Recent posts
    </h2>
    <WritingPostList posts={posts} showTags />
    <p class="mt-4"><a href="/writing" class="text-muted">All posts →</a></p>
  </section>
</Base>
