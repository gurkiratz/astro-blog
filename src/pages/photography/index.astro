---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const photos = (await getCollection('photos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Photography">
  <h1 class="text-ink font-medium" style="font-size:1.1rem">
    <span class="text-faint" data-marker></span> Photography
  </h1>
  <p class="mt-2 text-muted" style="font-size:0.9rem">a visual logbook.</p>

  <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3">
    {
      photos.map((photo) => (
        <a
          href={`/photography/${photo.id}/`}
          class="group block hover:no-underline"
        >
          <div class="aspect-[4/3] overflow-hidden rounded border border-rule">
            <Image
              src={photo.data.image}
              alt={photo.data.alt}
              widths={[300, 600]}
              sizes="(min-width: 768px) 230px, 45vw"
              class="h-full w-full object-cover transition-opacity group-hover:opacity-80"
            />
          </div>
          {photo.data.caption && (
            <p class="mt-1.5 text-faint" style="font-size:0.78rem">
              {photo.data.caption}
            </p>
          )}
        </a>
      ))
    }
  </div>
</Base>
