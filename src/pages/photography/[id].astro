---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const photos = await getCollection('photos', ({ data }) => !data.draft);
  return photos.map((photo) => ({
    params: { id: photo.id },
    props: { photo },
  }));
}

const { photo } = Astro.props;
const { Content } = await render(photo);
const hasNote = (photo.body ?? '').trim().length > 0;

const iso = (d: Date) => d.toISOString().slice(0, 10);
const meta = [
  iso(photo.data.date),
  photo.data.location,
  photo.data.tags.map((t) => `#${t}`).join(' '),
]
  .filter(Boolean)
  .join(' · ');
---

<Base title={photo.data.title} description={photo.data.caption}>
  <a
    href="/photography"
    class="text-faint hover:underline"
    style="font-size:0.8rem">← photography</a
  >

  <figure class="mt-4">
    <Image
      src={photo.data.image}
      alt={photo.data.alt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 736px) 700px, 100vw"
      class="h-auto w-full rounded border border-rule"
    />
    {
      photo.data.caption && (
        <figcaption class="mt-3 text-muted" style="font-size:0.9rem">
          {photo.data.caption}
        </figcaption>
      )
    }
  </figure>

  <p class="mt-2 text-faint" style="font-size:0.8rem">{meta}</p>

  {
    hasNote && (
      <div class="prose mt-6">
        <Content />
      </div>
    )
  }
</Base>
