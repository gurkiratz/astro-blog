---
const messages = [
  'om nom nom',
  'the fish is fine, probably',
  'catch and release',
  'the fish has retained a lawyer',
  'they rehearsed this, honestly',
  'a tiny truce was signed',
  'you scrolled all this way for this',
];
---

<button
  class="footer-doodle"
  type="button"
  data-footer-doodle
  data-messages={JSON.stringify(messages)}
  aria-label="Poke the cat and fish"
>
  <span class="footer-doodle__bubble" data-doodle-message aria-live="polite"></span>
  <span class="footer-doodle__characters" aria-hidden="true">
    <svg
      class="footer-doodle__cat"
      viewBox="0 0 34 30"
      width="32"
      height="28"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        class="footer-doodle__cat-tail"
        d="M9 24.5C5.5 25.7 3 23.5 3.6 20.7C4 18.9 6.1 18.3 7 19.7"
      />
      <path
        d="M9 26C7.8 22.4 8.4 18 12 15.2C14 13.6 16.6 12.8 19.2 12.6L19 8.4L20.4 4.2L23.4 6.2C24.8 5.8 26.2 5.8 27.6 6.2L30.6 4.4L30.4 8.6C31.6 10.6 31.2 13.2 29.4 14.6C28 15.7 26 16 24.4 15.4C26.6 18.2 27.4 22 27.2 26"
      />
      <path d="M23.6 26C23.8 23.4 23.4 21 22.4 19.2" />
      <path d="M24.6 10.6q0.8 0.9 1.6 0" />
      <path d="M28.2 10.4q0.8 0.9 1.6 0" />
      <path d="M31.4 12.6l2.2 -0.4" />
      <path d="M31.2 13.9l2.2 0.5" />
    </svg>
    <svg
      class="footer-doodle__fish"
      viewBox="0 0 26 18"
      width="24"
      height="17"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path
        class="footer-doodle__fish-tail"
        d="M18 9L22.8 5.4C21.9 7.8 21.9 10.2 22.8 12.6L18 9Z"
      />
      <path
        d="M4.2 9C7 4.8 12.6 3.6 16.4 6.4C17.9 7.5 18.4 8.4 18.2 9.2C17.9 10.2 17 11 15.8 11.8C12 14.4 6.8 13.2 4.2 9Z"
      />
      <path d="M10.6 7.6C12 8.6 12.3 10 11.4 11.4" />
      <circle cx="7.6" cy="8.2" r="0.8" fill="currentColor" stroke="none" />
      <circle class="footer-doodle__fish-bubble" cx="4.5" cy="4" r="0.9" />
      <circle
        class="footer-doodle__fish-bubble footer-doodle__fish-bubble--small"
        cx="6.8"
        cy="2.2"
        r="0.6"
      />
    </svg>
  </span>
</button>

<style>
  .footer-doodle {
    position: relative;
    display: inline-flex;
    align-items: flex-end;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-ink);
    font: inherit;
    line-height: 0;
    cursor: pointer;
  }

  .footer-doodle:hover,
  .footer-doodle:focus-visible {
    color: var(--color-accent);
  }

  .footer-doodle:focus-visible {
    border-radius: 3px;
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  .footer-doodle__characters {
    display: inline-flex;
    align-items: flex-end;
    gap: 0.9rem;
    line-height: 0;
    transition: transform 120ms ease;
  }

  .footer-doodle:active .footer-doodle__characters {
    transform: scale(0.93);
  }

  .footer-doodle__fish {
    margin-bottom: 5px;
  }

  .footer-doodle__bubble {
    position: absolute;
    right: -0.25rem;
    bottom: calc(100% + 0.65rem);
    padding: 0.3rem 0.6rem 0.35rem;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    color: var(--color-ink);
    line-height: 0.2;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
  }

  .footer-doodle__bubble::after {
    content: '';
    position: absolute;
    right: 0.9rem;
    bottom: -0.28rem;
    width: 0.45rem;
    height: 0.45rem;
    background: inherit;
    border-right: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    transform: rotate(45deg);
  }

  .footer-doodle__bubble.is-showing {
    animation: doodle-bubble var(--doodle-bubble-ms, 3400ms) ease both;
  }

  @keyframes doodle-bubble {
    0%,
    82% {
      opacity: 1;
      transform: translateY(0);
    }
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  /* text-morph character rules live in the is:global block below —
     the spans are created in client JS and never receive Astro's
     scoped attribute, so scoped selectors would not match them. */

  .footer-doodle__cat {
    animation: doodle-cat-bob 3.2s ease-in-out infinite;
    transform-origin: center bottom;
  }

  .footer-doodle__cat-tail {
    animation: doodle-tail-flick 3.2s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: right bottom;
  }

  .footer-doodle__fish {
    animation: doodle-fish-swim 2.6s ease-in-out infinite;
  }

  .footer-doodle__fish-tail {
    animation: doodle-fish-wag 1.1s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: left center;
  }

  .footer-doodle__fish-bubble {
    animation: doodle-fish-bubble 3.6s ease-in-out infinite;
    transform-box: fill-box;
    opacity: 0;
  }

  .footer-doodle__fish-bubble--small {
    animation-delay: 0.5s;
  }

  /* click gag: fish dives into the cat, cat gulps, fish respawns from the right */
  .footer-doodle.is-feeding .footer-doodle__fish {
    animation: doodle-fish-eaten 1900ms ease-in-out both;
  }

  .footer-doodle.is-feeding .footer-doodle__cat {
    animation: doodle-cat-gulp 1900ms ease-in-out both;
    transform-origin: center bottom;
  }

  @keyframes doodle-fish-eaten {
    0% {
      transform: none;
      opacity: 1;
    }
    40% {
      transform: translateX(-20px) translateY(-4px) rotate(-14deg);
      opacity: 1;
    }
    48% {
      transform: translateX(-26px) translateY(-2px) rotate(-20deg) scale(0.55);
      opacity: 1;
    }
    53% {
      transform: translateX(-29px) scale(0.1);
      opacity: 0;
    }
    72% {
      transform: translateX(12px) scale(0.9);
      opacity: 0;
    }
    85% {
      opacity: 1;
    }
    100% {
      transform: none;
      opacity: 1;
    }
  }

  @keyframes doodle-cat-gulp {
    0%,
    40% {
      transform: none;
    }
    50% {
      transform: scale(1.12, 0.86);
    }
    60% {
      transform: scale(0.94, 1.08);
    }
    68% {
      transform: scale(1);
    }
    82% {
      transform: rotate(-3deg);
    }
    100% {
      transform: none;
    }
  }

  @keyframes doodle-cat-bob {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    40% {
      transform: translateY(-1.5px) rotate(-2deg);
    }
    70% {
      transform: translateY(0.5px) rotate(1deg);
    }
  }

  @keyframes doodle-tail-flick {
    0%,
    100% {
      transform: rotate(0deg);
    }
    45% {
      transform: rotate(-10deg);
    }
    65% {
      transform: rotate(6deg);
    }
  }

  @keyframes doodle-fish-swim {
    0%,
    100% {
      transform: translateX(0) translateY(0) rotate(0deg);
    }
    50% {
      transform: translateX(-2.5px) translateY(-1.5px) rotate(-4deg);
    }
  }

  @keyframes doodle-fish-wag {
    0%,
    100% {
      transform: rotate(0deg);
    }
    50% {
      transform: rotate(9deg);
    }
  }

  @keyframes doodle-fish-bubble {
    0%,
    55% {
      opacity: 0;
      transform: translateY(2px);
    }
    70% {
      opacity: 0.8;
    }
    90%,
    100% {
      opacity: 0;
      transform: translateY(-3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-doodle__cat,
    .footer-doodle__cat-tail,
    .footer-doodle__fish,
    .footer-doodle__fish-tail {
      animation: none;
    }

    .footer-doodle__fish-bubble {
      animation: none;
      opacity: 0;
    }

    .footer-doodle.is-feeding .footer-doodle__fish,
    .footer-doodle.is-feeding .footer-doodle__cat {
      animation: none;
    }

    .footer-doodle__bubble.is-showing {
      animation: doodle-bubble-fade 2800ms ease both;
    }

    @keyframes doodle-bubble-fade {
      0% {
        opacity: 0;
      }
      12%,
      85% {
        opacity: 1;
      }
      100% {
        opacity: 0;
      }
    }
  }

  @media (max-width: 30rem) {
    .footer-doodle__bubble {
      max-width: 72vw;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
</style>

<!-- Global: the character spans are injected by client JS and never get
     Astro's scoped attribute, so their rules must live outside the scope. -->
<style is:global>
  .footer-doodle__char {
    display: inline-block;
    white-space: pre;
    line-height: 1.25;
    opacity: 0;
  }

  .footer-doodle__bubble.is-showing .footer-doodle__char {
    animation: doodle-char-in 260ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes doodle-char-in {
    from {
      opacity: 0;
      transform: translateY(0.4em) scale(0.7);
      filter: blur(2px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-doodle__bubble.is-showing .footer-doodle__char {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  function initializeFooterDoodles() {
    document.querySelectorAll<HTMLElement>('[data-footer-doodle]').forEach((doodle) => {
      if (doodle.dataset.ready === 'true') return;

      const bubble = doodle.querySelector<HTMLElement>('[data-doodle-message]');
      const messages = JSON.parse(doodle.dataset.messages ?? '[]') as string[];
      if (!bubble || messages.length === 0) return;

      const FEED_MS = 1900;
      let messageIndex = 0;
      let feeding = false;
      doodle.dataset.ready = 'true';

      const CHAR_STAGGER_MS = 30;

      doodle.addEventListener('click', () => {
        const text = messages[messageIndex];
        messageIndex = (messageIndex + 1) % messages.length;

        bubble.replaceChildren(
          ...[...text].map((char, i) => {
            const span = document.createElement('span');
            span.className = 'footer-doodle__char';
            span.textContent = char;
            span.style.animationDelay = `${i * CHAR_STAGGER_MS}ms`;
            return span;
          })
        );
        bubble.style.setProperty(
          '--doodle-bubble-ms',
          `${2600 + text.length * CHAR_STAGGER_MS}ms`
        );

        bubble.classList.remove('is-showing');
        void bubble.offsetWidth;
        bubble.classList.add('is-showing');

        if (feeding) return;
        feeding = true;
        doodle.classList.add('is-feeding');
        window.setTimeout(() => {
          doodle.classList.remove('is-feeding');
          feeding = false;
        }, FEED_MS + 100);
      });
    });
  }

  initializeFooterDoodles();
  document.addEventListener('astro:page-load', initializeFooterDoodles);
</script>
