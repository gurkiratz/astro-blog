---
// Same vanilla "script island" approach as HalftoneBackground.astro, using
// @paper-design/shaders' `water` effect: distorts the source image with an
// animated caustic ripple. Unlike halftone-dots this samples the image's
// actual RGB, so it reads as a real (moving) photo, not just a dot mask.
interface Props {
  class?: string;
}
const { class: className = 'pointer-events-none fixed inset-0' } = Astro.props;
---

<div
  data-water-bg
  aria-hidden="true"
  class={className}
  transition:persist="site-background"
>
</div>

<script>
  import {
    ShaderMount,
    waterFragmentShader,
    ShaderFitOptions,
    getShaderColorFromString,
    isPaperShaderElement,
  } from '@paper-design/shaders';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-water-bg]').forEach((el) => {
      // Already mounted and persisted across a View Transition — nothing to do.
      if (isPaperShaderElement(el)) return;

      const source = new Image();
      source.src = '/flower-2.jpg';

      source.onload = () => {
        new ShaderMount(
          el,
          waterFragmentShader,
          {
            u_image: source,
            u_colorBack: getShaderColorFromString('#16140f00'), // transparent — page bg shows through at the edges
            u_colorHighlight: getShaderColorFromString('#ffffffff'),
            u_highlights: 0.07,
            u_layering: 0.5,
            u_edges: 0, // "false" in the paper.design react example
            u_caustic: 0.1,
            u_waves: 0.3,
            u_size: 1,
            u_fit: ShaderFitOptions.cover, // "contain" in the react example, but cover fills a full-page bg
            u_scale: 1,
            u_rotation: 0,
            u_originX: 0.5,
            u_originY: 0.5,
            u_offsetX: 0,
            u_offsetY: 0,
            u_worldWidth: 0,
            u_worldHeight: 0,
          },
          undefined,
          1, // animated — this is the one shader here that actually moves
        );
      };
    });
  });
</script>
