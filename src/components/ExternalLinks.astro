---
import ExternalLinkIcon from './ExternalLinkIcon.astro';
---

<template id="external-link-icon-template">
  <ExternalLinkIcon />
</template>

<script>
  function enhanceExternalLinks(root: ParentNode = document) {
    const template = document.querySelector<HTMLTemplateElement>(
      '#external-link-icon-template',
    );
    if (!template) return;

    root.querySelectorAll<HTMLAnchorElement>('a[href^="http"]').forEach((link) => {
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      if (!link.querySelector('.external-link-icon')) {
        link.appendChild(template.content.cloneNode(true));
      }
    });
  }

  enhanceExternalLinks();
  document.addEventListener('astro:page-load', () => enhanceExternalLinks());
</script>
