---
// Theme button + dropdown, meant to sit in a `relative`-positioned header.
// Selecting an option dispatches a "themechange" CustomEvent<number> that
// ThemeBackground.astro listens for. Not persisted across navigations —
// it's stateless UI, so a fresh render on every page is fine.
import { Sparkles } from '@lucide/astro';
import { themes, themeLabel } from '../theme.config';
---

<div class="absolute top-0 right-0" data-theme-switcher>
  <button
    type="button"
    class="theme-toggle text-muted transition-colors duration-200 hover:text-accent"
    data-theme-toggle
    aria-label="Theme"
    aria-haspopup="true"
    aria-expanded="false"
    data-cuelume-press data-cuelume-release
  >
    <Sparkles class="theme-toggle-icon" size={18} aria-hidden="true" />
  </button>
  <div
    class="theme-menu absolute right-0 z-20 mt-2 min-w-36 rounded-md border border-rule py-1"
    data-theme-menu
    data-theme-easing-exempt
    role="menu"
    hidden
  >
    {
      themes.map((theme, index) => (
        <button
          type="button"
          class="theme-option block w-full px-3 py-1.5 text-left transition-colors duration-150"
          style="font-size:0.85rem"
          data-theme-option
          data-index={index}
          role="menuitemradio"
          aria-checked="false"
        >
          {themeLabel(theme)}
        </button>
      ))
    }
  </div>
</div>

<style>
  /* Generous hit area around the small icon, without shifting layout. */
  .theme-toggle {
    padding: 0.5rem;
    margin: -0.5rem;
  }

  .theme-toggle-icon {
    transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .theme-toggle:hover .theme-toggle-icon,
  .theme-toggle[aria-expanded='true'] .theme-toggle-icon {
    transform: rotate(-12deg) scale(1.08);
  }

  /* Instant press feedback on pointer-down, springy ease back on release. */
  .theme-toggle:active .theme-toggle-icon {
    transform: rotate(-12deg) scale(0.9);
    transition-duration: 0s;
  }

  /* A translucent material layer: the menu materializes — blur, scale, and
     opacity arrive together — anchored to the trigger (origin top right),
     and leaves along the same path. */
  .theme-menu {
    background: color-mix(in srgb, var(--color-surface) 72%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    backdrop-filter: blur(16px) saturate(160%);
    box-shadow:
      0 8px 24px -8px rgb(0 0 0 / 0.35),
      0 2px 6px rgb(0 0 0 / 0.12);
    opacity: 0;
    transform: translateY(-4px) scale(0.96);
    transform-origin: top right;
    transition:
      opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
      -webkit-backdrop-filter 180ms ease,
      backdrop-filter 180ms ease;
    pointer-events: none;
  }

  .theme-menu[data-open] {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .theme-menu {
      background: var(--color-surface);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-menu {
      transform: none;
      transition: opacity 150ms ease;
    }
    .theme-toggle-icon {
      transition: none;
    }
  }

  .theme-option {
    color: var(--color-ink);
    transition:
      background-color 150ms ease,
      color 150ms ease,
      opacity 150ms ease;
  }

  .theme-option:hover {
    background: color-mix(in srgb, var(--color-ink) 8%, transparent);
    color: var(--color-accent);
  }

  .theme-option:active {
    opacity: 0.55;
    transition-duration: 0s;
  }

  .theme-option[aria-checked='true'] {
    color: var(--color-accent);
    font-weight: 500;
  }

  .theme-option[aria-checked='true']::before {
    content: '· ';
  }
</style>

<script>
  import { getActiveThemeIndex } from '../theme.config';

  declare global {
    interface Window {
      __themeSwitcherInit?: boolean;
    }
  }

  function markActiveOption(menu: HTMLElement, active: number) {
    menu.querySelectorAll<HTMLElement>('[data-theme-option]').forEach((opt) => {
      const isActive = Number(opt.dataset.index) === active;
      opt.setAttribute('aria-checked', String(isActive));
    });
  }

  function setMenuOpen(menu: HTMLElement, toggle: HTMLElement, open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    const prev = (menu as HTMLElement & { __closeTimer?: number }).__closeTimer;
    if (prev) window.clearTimeout(prev);

    if (open) {
      markActiveOption(menu, getActiveThemeIndex());
      menu.hidden = false;
      // Next frame so the transition runs from the closed styles.
      requestAnimationFrame(() => menu.setAttribute('data-open', ''));
      return;
    }

    if (!menu.hasAttribute('data-open') && menu.hidden) return;

    menu.removeAttribute('data-open');
    (menu as HTMLElement & { __closeTimer?: number }).__closeTimer = window.setTimeout(() => {
      menu.hidden = true;
    }, 180);
  }

  // Delegated from `document` (not the switcher itself) and guarded by a
  // module-level flag: this script re-runs on every page since the switcher
  // isn't transition:persist'ed, but a plain document listener would
  // otherwise stack up one extra (dead, since its closed-over element gets
  // replaced) listener per navigation.
  if (!window.__themeSwitcherInit) {
    window.__themeSwitcherInit = true;

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const menu = document.querySelector<HTMLElement>('[data-theme-menu]');
      const toggle = document.querySelector<HTMLElement>('[data-theme-toggle]');
      if (!menu || !toggle) return;

      const optionButton = target.closest<HTMLElement>('[data-theme-option]');
      if (optionButton) {
        const index = Number(optionButton.dataset.index);
        markActiveOption(menu, index);
        window.dispatchEvent(new CustomEvent('themechange', { detail: index }));
        setMenuOpen(menu, toggle, false);
        return;
      }

      if (target.closest('[data-theme-toggle]')) {
        setMenuOpen(menu, toggle, !menu.hasAttribute('data-open'));
        return;
      }

      if (!target.closest('[data-theme-switcher]')) {
        setMenuOpen(menu, toggle, false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const menu = document.querySelector<HTMLElement>('[data-theme-menu]');
      const toggle = document.querySelector<HTMLElement>('[data-theme-toggle]');
      if (menu && toggle) setMenuOpen(menu, toggle, false);
    });
  }
</script>
