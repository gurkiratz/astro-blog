---
import { site } from '../site.config';
import ThemeSwitcher from './ThemeSwitcher.astro';
---

<header class="relative">
  <ThemeSwitcher />
  <a
    href="/"
    class="text-ink font-semibold md:font-bold text-lg md:text-xl no-underline hover:no-underline hover:text-ink"
  >
    <span class="text-accent">{site.prompt}</span>
    {site.name}
  </a>
  {
    site.tagline ? (
      <p class="mt-0.5 text-faint" style="font-size:0.9rem">
        {site.tagline}
      </p>
    ) : null
  }
  <nav class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
    {
      site.nav.map((item) => {
        const current =
          item.href === '/'
            ? Astro.url.pathname === '/'
            : Astro.url.pathname.startsWith(item.href);
        return (
          <a
            href={item.href}
            class:list={[
              'no-underline hover:text-accent',
              current ? 'text-ink' : 'text-muted',
            ]}
            aria-current={current ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>
</header>
