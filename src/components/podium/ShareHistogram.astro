---
// How the 200 rewritten records scored, bucketed by AI share (average of
// sentence scores). Counts come from the project's database. Static, no JS.
const provincial = [56, 19, 1, 1, 3, 3, 2, 4, 1, 10];
const federal = [18, 4, 7, 3, 7, 12, 36, 11, 1, 1];

const max = Math.max(...provincial.map((p, i) => p + federal[i]));
const h = (n: number) => `${(n / max) * 100}%`;
---

<figure class="my-6">
  <div class="rounded-lg border border-rule bg-surface p-4">
    <div class="flex gap-3 text-muted" style="font-size:0.75rem">
      <span class="flex items-center gap-1.5"><i class="swatch prov"></i>Provincial</span>
      <span class="flex items-center gap-1.5"><i class="swatch fed"></i>Federal</span>
    </div>
    <div class="mt-4 flex h-40 items-end gap-1.5" role="img" aria-label="Histogram of AI share across 200 records. Provincial records pile up near 0%; federal records cluster around 60 to 70%.">
      {
        provincial.map((p, i) => (
          <div class="flex h-full flex-1 flex-col justify-end" title={`${i * 10}–${i * 10 + 10}%: ${p} provincial, ${federal[i]} federal`}>
            <div class="bar fed" style={`height:${h(federal[i])}`} />
            <div class="bar prov" style={`height:${h(p)}`} />
          </div>
        ))
      }
    </div>
    <div class="mt-2 flex justify-between text-faint tabular-nums" style="font-size:0.7rem">
      <span>0% AI</span><span>50%</span><span>100%</span>
    </div>
  </div>
  <figcaption>AI share of the 200 rewritten records.</figcaption>
</figure>

<style>
  .swatch {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 2px;
  }
  .bar {
    width: 100%;
  }
  .bar + .bar {
    margin-top: 2px;
  }
  .bar:first-child {
    border-radius: 3px 3px 0 0;
  }
  .prov {
    background: var(--color-tag-teal);
  }
  .fed {
    background: var(--color-tag-pink);
  }
</style>
