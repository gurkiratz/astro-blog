---
// The Bill Oliver clip, scored two ways. Numbers come straight from the
// project's database (GPTZero output). Vanilla script, no framework.
const WHOLE_TEXT = 0.284;

const sentences = [
  { text: 'Another concern relates to expectations.', ai: 0.13 },
  {
    text: 'One of the dangers associated with creating advocacy offices is that citizens often develop expectations that exceed the powers actually granted to those offices.',
    ai: 0.079,
  },
  {
    text: "Here's a more natural flowing version of that section that reads like a legislative speech rather than a series of short points.",
    ai: 0.057,
    note: "That's the chatbot's own preamble, read out loud in the legislature.",
  },
  {
    text: 'Madam Speaker, one of my concerns with this legislation is the potential gap between what New Brunswickers may reasonably expect this office to accomplish and what the office will actually have the authority to do once it is established.',
    ai: 0.066,
  },
];

const average = sentences.reduce((sum, s) => sum + s.ai, 0) / sentences.length;
const pct = (n: number) => `${Math.round(n * 100)}%`;
// Tint strength. Every score here sits under 30%, so the ramp tops out there
// instead of at 100% — otherwise 6% and 13% look identical.
const tint = (n: number) => `${Math.round(3 + Math.min(n / 0.3, 1) * 44)}%`;
---

<div
  class="my-6 rounded-lg border border-rule bg-surface p-4"
  data-explorer
  data-whole={WHOLE_TEXT}
  data-average={average}
  style={`--tint-whole:${tint(WHOLE_TEXT)}`}
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="seg" role="group" aria-label="Scoring mode">
      <button type="button" data-mode="sentence" aria-pressed="true">Sentence by sentence</button>
      <button type="button" data-mode="whole" aria-pressed="false">Whole text</button>
    </div>
    <p class="tabular-nums text-ink" style="font-size:0.9rem">
      <span data-total>{pct(average)}</span>&nbsp;<span class="text-faint">AI</span>
    </p>
  </div>

  <p class="mt-4 leading-relaxed" style="font-size:0.95rem">
    {
      sentences.map((s, i) => (
        <>
          <span
            role="button"
            tabindex="0"
            class="sentence"
            data-i={i}
            data-ai={s.ai}
            data-note={s.note ?? ''}
            style={`--tint:${tint(s.ai)}`}
          >
            {s.text}<span class="score" aria-hidden="true">{pct(s.ai)}</span>
          </span>{' '}
        </>
      ))
    }
  </p>

  <p class="mt-4 text-muted" style="font-size:0.85rem" data-detail aria-live="polite">
    Tap a sentence to see its score.
  </p>
</div>

<script>
  const pct = (n: number) => `${Math.round(n * 100)}%`;

  function init() {
    document.querySelectorAll<HTMLElement>('[data-explorer]:not([data-ready])').forEach((root) => {
      root.setAttribute('data-ready', '');
      const whole = Number(root.dataset.whole);
      const average = Number(root.dataset.average);
      const total = root.querySelector('[data-total]')!;
      const detail = root.querySelector('[data-detail]')!;
      const sentences = [...root.querySelectorAll<HTMLElement>('.sentence')];
      const modeButtons = [...root.querySelectorAll<HTMLElement>('[data-mode]')];
      const hint: Record<string, string> = {
        sentence: 'Tap a sentence to see its score.',
        whole: `Scored as one block, the same four sentences come out at ${pct(whole)} AI, over three times the sentence average.`,
      };

      const setMode = (mode: string) => {
        root.dataset.mode = mode;
        modeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === mode)));
        sentences.forEach((s) => s.removeAttribute('aria-current'));
        total.textContent = pct(mode === 'whole' ? whole : average);
        detail.textContent = hint[mode];
      };

      modeButtons.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode!)));

      sentences.forEach((s) => {
        const select = () => {
          if (root.dataset.mode === 'whole') setMode('sentence');
          sentences.forEach((o) => o.toggleAttribute('aria-current', o === s));
          const n = Number(s.dataset.i) + 1;
          const note = s.dataset.note;
          detail.textContent = `Sentence ${n}: ${pct(Number(s.dataset.ai))} AI.${note ? ' ' + note : ''}`;
        };
        s.addEventListener('click', select);
        s.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            select();
          }
        });
      });

      setMode('sentence');
    });
  }

  // Runs on first load and after every client-side navigation.
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .seg {
    display: inline-flex;
    gap: 2px;
    padding: 2px;
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
    font-size: 0.8rem;
  }
  .seg button {
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    color: var(--color-muted);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .seg button[aria-pressed='true'] {
    background: var(--color-base);
    color: var(--color-ink);
  }
  .sentence {
    padding: 0.05em 0.15em;
    border-radius: 3px;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-tag-pink) var(--tint), transparent);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    cursor: pointer;
    transition: background-color 0.3s ease, box-shadow 0.15s ease;
  }
  [data-mode='whole'] .sentence {
    background: color-mix(in srgb, var(--color-tag-pink) var(--tint-whole), transparent);
  }
  .score {
    margin-left: 0.35em;
    font-size: 0.7em;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }
  [data-mode='whole'] .score {
    display: none;
  }
  .sentence[aria-current] {
    box-shadow: 0 0 0 1.5px var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .sentence,
    .seg button {
      transition: none;
    }
  }
</style>
