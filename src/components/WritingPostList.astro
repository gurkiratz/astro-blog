---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'writing'>[];
  groupByYear?: boolean;
  showTags?: boolean;
}

const { posts, groupByYear = false, showTags = false } = Astro.props;

const shortDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

const searchText = (post: CollectionEntry<'writing'>) =>
  [post.data.title, ...post.data.tags].join(' ').toLowerCase();

const byYear = new Map<number, CollectionEntry<'writing'>[]>();
if (groupByYear) {
  for (const post of posts) {
    const year = post.data.date.getFullYear();
    const list = byYear.get(year);
    if (list) list.push(post);
    else byYear.set(year, [post]);
  }
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

{
  groupByYear ? (
    years.map((year) => (
      <section class="mt-8">
        <h2 class="mb-2 text-faint" style="font-size:0.8rem">
          {year}
        </h2>
        <ul class="space-y-2">
          {byYear.get(year)!.map((post) => (
            <li
              class="writing-post-item flex items-baseline gap-x-3"
              data-search={searchText(post)}
            >
              <span
                class="w-12 shrink-0 text-faint tabular-nums"
                style="font-size:0.85rem"
              >
                {shortDate(post.data.date)}
              </span>
              <div class="min-w-0 flex-1">
                <a
                  href={`/writing/${post.id}/`}
                  class="writing-post-link no-underline hover:underline"
                >
                  {post.data.title}
                </a>
                {showTags && post.data.tags[0] && (
                  <span
                    class="ml-2 text-faint"
                    style="font-size:0.85rem"
                    data-tag={post.data.tags[0]}
                  >
                    {post.data.tags[0]}
                  </span>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  ) : (
    <ul class="space-y-2">
      {posts.map((post) => (
        <li
          class="writing-post-item flex items-baseline gap-x-3"
          data-search={searchText(post)}
        >
          <span
            class="w-12 shrink-0 text-faint tabular-nums"
            style="font-size:0.85rem"
          >
            {shortDate(post.data.date)}
          </span>
          <div class="min-w-0 flex-1">
            <a
              href={`/writing/${post.id}/`}
              class="writing-post-link no-underline hover:underline"
            >
              {post.data.title}
            </a>
            {showTags && post.data.tags[0] && (
              <span
                class="ml-2 text-faint"
                style="font-size:0.85rem"
                data-tag={post.data.tags[0]}
              >
                {post.data.tags[0]}
              </span>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}
