---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'writing'>[];
  groupByYear?: boolean;
  showTags?: boolean;
}

const { posts, groupByYear = false, showTags = false } = Astro.props;

const shortDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });

const byYear = new Map<number, CollectionEntry<'writing'>[]>();
if (groupByYear) {
  for (const post of posts) {
    const year = post.data.date.getFullYear();
    const list = byYear.get(year);
    if (list) list.push(post);
    else byYear.set(year, [post]);
  }
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

{
  groupByYear ? (
    years.map((year) => (
      <section class="mt-8">
        <h2 class="mb-2 text-faint" style="font-size:0.8rem">
          {year}
        </h2>
        <ul class="space-y-2">
          {byYear.get(year)!.map((post) => (
            <li class="writing-post-item flex flex-wrap items-baseline gap-x-3">
              <span
                class="w-12 shrink-0 text-faint tabular-nums"
                style="font-size:0.85rem"
              >
                {shortDate(post.data.date)}
              </span>
              <a
                href={`/writing/${post.id}/`}
                class="writing-post-link no-underline hover:underline"
              >
                {post.data.title}
              </a>
              {showTags && post.data.tags[0] && (
                <span class="text-faint" style="font-size:0.85rem">
                  {post.data.tags[0]}
                </span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  ) : (
    <ul class="space-y-2">
      {posts.map((post) => (
        <li class="writing-post-item flex flex-wrap items-baseline gap-x-3">
          <span
            class="w-12 shrink-0 text-faint tabular-nums"
            style="font-size:0.85rem"
          >
            {shortDate(post.data.date)}
          </span>
          <a
            href={`/writing/${post.id}/`}
            class="writing-post-link no-underline hover:underline"
          >
            {post.data.title}
          </a>
          {showTags && post.data.tags[0] && (
            <span class="text-faint" style="font-size:0.85rem">
              {post.data.tags[0]}
            </span>
          )}
        </li>
      ))}
    </ul>
  )
}
