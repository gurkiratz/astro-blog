---
// Same vanilla "script island" approach as HalftoneBackground.astro, using
// @paper-design/shaders' `halftone-cmyk` effect: a 4-channel print-style
// halftone (like an old comic/newspaper reproduction) with independent
// ink colors per channel. Also needs the generated noise texture image
// (see PaperTextureBackground.astro for why).
interface Props {
  class?: string;
}
const { class: className = 'pointer-events-none fixed inset-0' } = Astro.props;
---

<div
  data-halftone-cmyk-bg
  aria-hidden="true"
  class={className}
  transition:persist="site-background"
>
</div>

<script>
  import {
    ShaderMount,
    halftoneCmykFragmentShader,
    HalftoneCmykTypes,
    ShaderFitOptions,
    getShaderColorFromString,
    getShaderNoiseTexture,
    isPaperShaderElement,
  } from '@paper-design/shaders';

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-halftone-cmyk-bg]').forEach((el) => {
      // Already mounted and persisted across a View Transition — nothing to do.
      if (isPaperShaderElement(el)) return;

      const source = new Image();
      source.src = '/flower-2.jpg';
      const noise = getShaderNoiseTexture();

      Promise.all(
        [source, noise].filter((img) => img !== undefined).map(
          (img) =>
            new Promise((resolve) => {
              if (img!.complete) resolve(undefined);
              else img!.onload = () => resolve(undefined);
            }),
        ),
      ).then(() => {
        new ShaderMount(
          el,
          halftoneCmykFragmentShader,
          {
            u_image: source,
            u_noiseTexture: noise,
            u_colorBack: getShaderColorFromString('#fbfaf4'),
            u_colorC: getShaderColorFromString('#00b3ff'),
            u_colorM: getShaderColorFromString('#fc4f9d'),
            u_colorY: getShaderColorFromString('#ffd900'),
            u_colorK: getShaderColorFromString('#231f20'),
            u_size: 0.2,
            u_gridNoise: 0.2,
            u_type: HalftoneCmykTypes.ink,
            u_softness: 1,
            u_contrast: 1,
            u_floodC: 0.15,
            u_floodM: 0,
            u_floodY: 0,
            u_floodK: 0,
            u_gainC: 0.3,
            u_gainM: 0,
            u_gainY: 0.2,
            u_gainK: 0,
            u_grainMixer: 0,
            u_grainOverlay: 0,
            u_grainSize: 0.5,
            u_fit: ShaderFitOptions.cover,
            u_scale: 1,
            u_rotation: 0,
            u_originX: 0.5,
            u_originY: 0.5,
            u_offsetX: 0,
            u_offsetY: 0,
            u_worldWidth: 0,
            u_worldHeight: 0,
          },
          undefined,
          0, // no animation uniform in this shader
        );
      });
    });
  });
</script>
