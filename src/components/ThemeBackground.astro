---
// Single persisted background layer, driven by whichever theme (image +
// accent color + shader component) is selected via ThemeSwitcher.astro,
// which dispatches a "themechange" CustomEvent<number> (the theme's index
// in theme.config.ts) that this script listens for. The choice is saved to
// localStorage so it survives reloads, and the initial pick is applied
// before paint by an inline script in Base.astro's <head> (see there for why).
---

<div
  data-theme-bg
  aria-hidden="true"
  class="pointer-events-none fixed inset-0"
  transition:persist="site-background"
>
</div>

<script>
  import { isPaperShaderElement } from '@paper-design/shaders';
  import { mountThemeBackground } from '../lib/shaderBackgrounds';
  import {
    themes,
    THEME_STORAGE_KEY,
    getStoredThemeIndex,
    themeOpacityFraction,
    type ThemeEntry,
  } from '../theme.config';

  function applyThemeStyle(theme: ThemeEntry) {
    document.documentElement.style.setProperty('--color-accent', theme.color);
    document.documentElement.style.setProperty('--scrim-opacity', String(themeOpacityFraction(theme)));
  }

  document.addEventListener('astro:page-load', () => {
    // Re-applied on every page load, not just the first: Astro's View
    // Transitions re-render <html> from each freshly-fetched page (which has
    // no inline style — that's only ever added by this script), which wipes
    // the --color-accent/--scrim-opacity overrides set on the previous page.
    // The shader itself doesn't need remounting once persisted, but these
    // styles do need reasserting every time, so this must run unconditionally
    // rather than being skipped alongside the mount when already mounted.
    const theme = themes[getStoredThemeIndex()];
    applyThemeStyle(theme);

    document.querySelectorAll<HTMLElement>('[data-theme-bg]').forEach((el) => {
      // Already mounted and persisted across a View Transition — nothing to do.
      if (isPaperShaderElement(el)) return;
      mountThemeBackground(el, theme.component, theme.image);
    });
  });

  window.addEventListener('themechange', (event) => {
    const index = (event as CustomEvent<number>).detail;
    const theme = themes[index];
    if (!theme) return;

    localStorage.setItem(THEME_STORAGE_KEY, String(index));
    applyThemeStyle(theme);

    document.querySelectorAll<HTMLElement>('[data-theme-bg]').forEach((el) => {
      if (isPaperShaderElement(el)) el.paperShaderMount?.dispose();
      mountThemeBackground(el, theme.component, theme.image);
    });
  });
</script>
