---
// Single persisted background layer, driven by whichever theme (image +
// accent color) is selected via ThemeSwitcher.astro, which dispatches a
// "themechange" CustomEvent<number> (the theme's index in theme.config.ts)
// that this script listens for. The choice is saved to localStorage so it
// survives reloads, and the initial pick is applied before paint by an
// inline script in Base.astro's <head> (see there for why).
//
// The image is read from --theme-image/--theme-position on <html> (with the
// first theme as fallback), so the FOUC script can set the right image
// before this element even exists in the DOM.
import { themes, themePosition } from '../theme.config';

const fallback = themes[0];
---

<div
  data-theme-bg
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 bg-cover bg-no-repeat"
  style={`background-image: var(--theme-image, url('${fallback.image}')); background-position: var(--theme-position, ${themePosition(fallback)})`}
  transition:persist="site-background"
>
</div>

<script>
  import {
    themes,
    THEME_STORAGE_KEY,
    getStoredThemeIndex,
    themeOpacityFraction,
    themePosition,
    type ThemeEntry,
  } from '../theme.config';

  function applyThemeStyle(theme: ThemeEntry) {
    const root = document.documentElement.style;
    root.setProperty('--color-accent', theme.color);
    root.setProperty('--scrim-opacity', String(themeOpacityFraction(theme)));
    root.setProperty('--theme-image', `url('${theme.image}')`);
    root.setProperty('--theme-position', themePosition(theme));
  }

  // Re-applied on every page load, not just the first: Astro's View
  // Transitions re-render <html> from each freshly-fetched page (which has
  // no inline style — that's only ever added by this script and the FOUC
  // script in Base.astro's <head>), which wipes the CSS variable overrides
  // set on the previous page.
  document.addEventListener('astro:page-load', () => {
    applyThemeStyle(themes[getStoredThemeIndex()]);
  });

  window.addEventListener('themechange', (event) => {
    const index = (event as CustomEvent<number>).detail;
    const theme = themes[index];
    if (!theme) return;

    localStorage.setItem(THEME_STORAGE_KEY, String(index));
    applyThemeStyle(theme);
  });
</script>
